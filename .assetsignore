# Files excluded from the Cloudflare Pages deployment.
# Pages uploads the whole directory and does NOT honour .gitignore, so the test /
# tooling assets must be listed here to keep them off the public CDN. The deployed
# site is the static product: index.html, locale dirs (de/ fr/ it/ es/), styles.css,
# favicon.*, og.png, robots.txt, sitemap.xml, llms.txt, .well-known/ and brand/.

# Build / test / tooling
assets/
node_modules/
scripts/
test/
tests/
coverage/
playwright-report/
test-results/
*.mjs
package.json
package-lock.json

# Tooling config
.htmlvalidate.json
.prettierrc.json
.prettierignore
.assetsignore
.lycheeignore
